# Patch Typhoeus to increase CocoaPods CDN timeout to 120s and use HTTP/1.1
begin
  require 'typhoeus'
  module Typhoeus
    class Request
      unless method_defined?(:orig_custom_init)
        alias_method :orig_custom_init, :initialize
        def initialize(base_url, options = {})
          options[:timeout] = 120 if options[:timeout] && options[:timeout] < 120
          options[:connecttimeout] = 120 if options[:connecttimeout] && options[:connecttimeout] < 120
          options[:http_version] = :httpv1_1 if options[:http_version] == :httpv2_0
          orig_custom_init(base_url, options)
        end
      end
    end
  end
rescue LoadError
  # Typhoeus will be required when CocoaPods downloads specs
end

source 'https://cdn.cocoapods.org/'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

$RNFirebaseAsStaticFramework = true
use_frameworks! :linkage => :static
use_modular_headers!

target 'Touch' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'TouchTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # 1. Fix deployment target for pods that specify versions below 15.0
    # Xcode requires a minimum of 15.0
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target && Gem::Version.new(deployment_target) < Gem::Version.new('15.0')
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end
      end

      # 2. Fix fmt consteval error on Apple Clang / Xcode 16+
      if target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
          definitions = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          definitions = [definitions] unless definitions.is_a?(Array)
          definitions << 'FMT_USE_CONSTEVAL=0' unless definitions.include?('FMT_USE_CONSTEVAL=0')
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions
        end
      end

      # 3. Suppress Xcode warnings for script phases with no outputs in Pod targets
      target.build_phases.each do |phase|
        if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
          output_paths = phase.respond_to?(:output_paths) && phase.output_paths ? phase.output_paths : []
          output_file_list_paths = phase.respond_to?(:output_file_list_paths) && phase.output_file_list_paths ? phase.output_file_list_paths : []
          has_outputs = !output_paths.empty? || !output_file_list_paths.empty?
          if !has_outputs && phase.respond_to?(:always_out_of_date=)
            phase.always_out_of_date = '1'
          end
        end
      end
    end

    # Suppress Xcode warnings for script phases with no outputs in main project
    installer.aggregate_targets.each do |aggregate_target|
      project = aggregate_target.user_project
      project.targets.each do |target|
        target.build_phases.each do |phase|
          if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
            output_paths = phase.respond_to?(:output_paths) && phase.output_paths ? phase.output_paths : []
            output_file_list_paths = phase.respond_to?(:output_file_list_paths) && phase.output_file_list_paths ? phase.output_file_list_paths : []
            has_outputs = !output_paths.empty? || !output_file_list_paths.empty?
            if !has_outputs && phase.respond_to?(:always_out_of_date=)
              phase.always_out_of_date = '1'
            end
          end
        end
      end
      project.save
    end

    # 4. Patch fmt/base.h header directly to disable consteval on Apple Clang
    fmt_base_headers = Dir.glob(File.join(installer.sandbox.root, 'fmt', '**', 'base.h'))
    fmt_base_headers.each do |header_file|
      if File.exist?(header_file)
        content = File.read(header_file)
        new_content = content.gsub(
          '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L',
          '#elif defined(__apple_build_version__)'
        )
        if new_content != content
          File.chmod(0644, header_file)
          File.write(header_file, new_content)
          puts "Applied Apple Clang consteval patch to #{header_file}"
        end
      end
    end
  end
end
