# Patch Typhoeus to increase CocoaPods CDN timeout to 120s and use HTTP/1.1
begin
  require 'typhoeus'
  module Typhoeus
    class Request
      unless method_defined?(:orig_custom_init)
        alias_method :orig_custom_init, :initialize
        def initialize(base_url, options = {})
          options[:timeout] = 120 if options[:timeout] && options[:timeout] < 120
          options[:connecttimeout] = 120 if options[:connecttimeout] && options[:connecttimeout] < 120
          options[:http_version] = :httpv1_1 if options[:http_version] == :httpv2_0
          orig_custom_init(base_url, options)
        end
      end
    end
  end
rescue LoadError
  # Typhoeus will be required when CocoaPods downloads specs
end

source 'https://cdn.cocoapods.org/'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native-permissions/scripts/setup.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

$RNFirebaseAsStaticFramework = true
use_frameworks! :linkage => :static
use_modular_headers!

setup_permissions([
  'Camera',
  'Microphone',
  'PhotoLibrary',
  'Notifications',
])

target 'Touch' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'TouchTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # 1. Fix deployment target, inhibit third-party warnings, and configure fmt/scripts
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
        config.build_settings['OTHER_LDRFLAGS'] = '-Wl,-no_warn_duplicate_libraries'
      end

      # 2. Fix fmt consteval error on Apple Clang / Xcode 16+
      if target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
          definitions = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          definitions = [definitions] unless definitions.is_a?(Array)
          definitions << 'FMT_USE_CONSTEVAL=0' unless definitions.include?('FMT_USE_CONSTEVAL=0')
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions
        end
      end

      # 3. Suppress comma operator warnings in RCT-Folly
      if target.name == 'RCT-Folly'
        target.build_configurations.each do |config|
          cflags = config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
          config.build_settings['OTHER_CFLAGS'] = "#{cflags} -Wno-comma"
        end
      end

      # 4. Suppress Xcode warnings for script phases with no outputs in Pod targets
      target.build_phases.each do |phase|
        if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
          output_paths = phase.respond_to?(:output_paths) && phase.output_paths ? phase.output_paths : []
          output_file_list_paths = phase.respond_to?(:output_file_list_paths) && phase.output_file_list_paths ? phase.output_file_list_paths : []
          has_outputs = !output_paths.empty? || !output_file_list_paths.empty?
          if !has_outputs && phase.respond_to?(:always_out_of_date=)
            phase.always_out_of_date = '1'
          end
        end
      end
    end
    installer.pods_project.root_object.attributes['LastUpgradeCheck'] = '2710'
    installer.pods_project.root_object.attributes['LastSwiftUpdateCheck'] = '1600'
    installer.pods_project.save

    # Suppress Xcode warnings and configure main project
    installer.aggregate_targets.each do |aggregate_target|
      project = aggregate_target.user_project
      project.build_configurations.each do |config|
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        config.build_settings['CLANG_WARN_COMMA'] = 'NO'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
      end
      project.targets.each do |target|
        target.build_phases.each do |phase|
          if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
            if phase.name == '[CP-User] [RNFB] Core Configuration'
              phase.output_paths = ['$(DERIVED_FILE_DIR)/rnfb-core-config.txt']
            else
              output_paths = phase.respond_to?(:output_paths) && phase.output_paths ? phase.output_paths : []
              output_file_list_paths = phase.respond_to?(:output_file_list_paths) && phase.output_file_list_paths ? phase.output_file_list_paths : []
              has_outputs = !output_paths.empty? || !output_file_list_paths.empty?
              if !has_outputs && phase.respond_to?(:always_out_of_date=)
                phase.always_out_of_date = '1'
              end
            end
          end
        end

        # Ensure Swift toolchain search paths and settings on Touch target
        if target.name == 'Touch'
          target.build_configurations.each do |config|
            config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
            config.build_settings['SWIFT_VERSION'] = '5.0'
            config.build_settings['SWIFT_OBJC_BRIDGING_HEADER'] = 'Touch/Touch-Bridging-Header.h'
            cxx_flags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
            cxx_flags = [cxx_flags] unless cxx_flags.is_a?(Array)
            cxx_flags << '-Wno-comma' unless cxx_flags.include?('-Wno-comma')
            config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cxx_flags
            config.build_settings['OTHER_LDRFLAGS'] = '-Wl,-no_warn_duplicate_libraries'
            lib_paths = config.build_settings['LIBRARY_SEARCH_PATHS'] || ['$(inherited)']
            lib_paths = [lib_paths] unless lib_paths.is_a?(Array)
            [
              '$(inherited)',
              '"$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)"',
              '"$(TOOLCHAIN_DIR)/usr/lib/swift-5.0/$(PLATFORM_NAME)"',
              '"$(SDKROOT)/usr/lib/swift"'
            ].each do |path|
              lib_paths << path unless lib_paths.include?(path)
            end
            config.build_settings['LIBRARY_SEARCH_PATHS'] = lib_paths
          end

          # Ensure Touch target has Copy Hermes dSYM build phase
          phase_name = 'Copy Hermes dSYM'
          unless target.build_phases.any? { |p| p.respond_to?(:name) && p.name == phase_name }
            phase = project.new(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
            phase.name = phase_name
            phase.shell_path = '/bin/sh'
            phase.shell_script = %(if [ -d "${PODS_ROOT}/../dSYMs/hermes.framework.dSYM" ] && [ -n "${DWARF_DSYM_FOLDER_PATH:-}" ]; then\n  mkdir -p "${DWARF_DSYM_FOLDER_PATH}"\n  /usr/bin/rsync -a --delete "${PODS_ROOT}/../dSYMs/hermes.framework.dSYM" "${DWARF_DSYM_FOLDER_PATH}/"\nfi\n)
            phase.always_out_of_date = '1'
            target.build_phases << phase
          end
        end
      end
      project.save
    end

    # 5. Ensure ENABLE_MODULE_VERIFIER is disabled across all Pods targets
    pods_project_path = installer.pods_project.path
    if File.exist?(File.join(pods_project_path, 'project.pbxproj'))
      pbxproj_file = File.join(pods_project_path, 'project.pbxproj')
      content = File.read(pbxproj_file)
      if content.include?('ENABLE_MODULE_VERIFIER = YES;')
        File.write(pbxproj_file, content.gsub('ENABLE_MODULE_VERIFIER = YES;', 'ENABLE_MODULE_VERIFIER = NO;'))
      end
    end

    # 6. Ensure nanopb headers use modular angle-bracket includes
    umbrella = File.join(installer.sandbox.root, 'Target Support Files/nanopb/nanopb-umbrella.h')
    if File.exist?(umbrella)
      content = File.read(umbrella)
      new_content = content.gsub('#import "pb', '#import <nanopb/pb')
      File.write(umbrella, new_content) if new_content != content
    end
    ['pb_common.h', 'pb_decode.h', 'pb_encode.h'].each do |hdr|
      hdr_path = File.join(installer.sandbox.root, 'nanopb', hdr)
      if File.exist?(hdr_path)
        content = File.read(hdr_path)
        new_content = content.gsub('#include "pb.h"', '#include <nanopb/pb.h>')
        if new_content != content
          File.chmod(0644, hdr_path)
          File.write(hdr_path, new_content)
        end
      end
    end
  end
end
