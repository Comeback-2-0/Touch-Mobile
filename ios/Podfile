# Patch Typhoeus to increase CocoaPods CDN timeout to 120s and use HTTP/1.1
begin
  require 'typhoeus'
  module Typhoeus
    class Request
      unless method_defined?(:orig_custom_init)
        alias_method :orig_custom_init, :initialize
        def initialize(base_url, options = {})
          options[:timeout] = 120 if options[:timeout] && options[:timeout] < 120
          options[:connecttimeout] = 120 if options[:connecttimeout] && options[:connecttimeout] < 120
          options[:http_version] = :httpv1_1 if options[:http_version] == :httpv2_0
          orig_custom_init(base_url, options)
        end
      end
    end
  end
rescue LoadError
  # Typhoeus will be required when CocoaPods downloads specs
end

source 'https://cdn.cocoapods.org/'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

$RNFirebaseAsStaticFramework = true
use_frameworks! :linkage => :static


target 'Touch' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'TouchTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
